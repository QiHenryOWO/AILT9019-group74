# Copy this file to .env and fill in your group key.
# The key comes from the AILT9019 teaching team email (Alibaba Cloud Bailian).
# IMPORTANT: never commit .env. It is gitignored. Keep the key inside your group only.
BAILIAN_API_KEY=your_group_api_key_here
BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# A flash chat model available on the sponsored plan (verified: qwen3.8-flash).
# No embedding model is needed - retrieval uses lexical BM25 search.
CHAT_MODEL=qwen3.8-flash
